-- 키 검증 함수
------------------------------------------------------------
local function tryUnlock()
    local input = keyInput.Text
    if input == "" then
        statusLabel.Text = "⚠ 키를 입력해주세요."
        statusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
        return
    end

    local role = VALID_KEYS[input]
    if role then
        unlocked = true
        currentRole = role
        statusLabel.Text = "✅ 인증 성공! (" .. role .. ")"
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        task.wait(0.4)
        keyGui:Destroy()
        loadMainUI()
    else
        statusLabel.Text = "❌ 잘못된 키입니다."
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        local origPos = mainFrame.Position
        for i = 1, 4 do
            mainFrame.Position = origPos + UDim2.fromOffset(6, 0)
            task.wait(0.03)
            mainFrame.Position = origPos + UDim2.fromOffset(-6, 0)
            task.wait(0.03)
        end
        mainFrame.Position = origPos
    end
end

enterBtn.MouseButton1Click:Connect(tryUnlock)
keyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then tryUnlock() end
end)

